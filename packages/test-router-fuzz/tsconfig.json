{
  // `rootDir` is the repo root because the suite imports the shared fuzz core from packages/run-types/test/,
  // outside this directory. No `references` and not composite on purpose: nothing points here and this points
  // nowhere, so it cannot close a cycle in the project graph the way its old home in packages/router did.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": "../..",
    "sourceMap": false,
    "types": ["@types/node"]
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
