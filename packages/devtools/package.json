{
  "name": "@mionjs/devtools",
  "version": "0.12.2",
  "description": "mion devtools: the build transform (Vite/Rollup/Rolldown/webpack/Rspack/esbuild/Bun/Next-Turbopack) that rewrites mion RunTypes marker calls, the mion Vite and Next presets, and the OXlint/ESLint plugin.",
  "type": "module",
  "license": "MIT",
  "author": "ma jerez",
  "keywords": [
    "typescript",
    "vite",
    "next",
    "turbopack",
    "eslint",
    "oxlint",
    "plugin",
    "codegen",
    "mion"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unplugin": {
      "types": "./dist/core/unplugin.d.ts",
      "import": "./dist/core/unplugin.js"
    },
    "./vite": {
      "source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./next": {
      "source": "./src/next/index.ts",
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./eslint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js"
    },
    "./oxlint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js"
    },
    "./runtypes/vite": {
      "types": "./dist/runtypes/vite.d.ts",
      "import": "./dist/runtypes/vite.js"
    },
    "./runtypes/rollup": {
      "types": "./dist/runtypes/rollup.d.ts",
      "import": "./dist/runtypes/rollup.js"
    },
    "./runtypes/rolldown": {
      "types": "./dist/runtypes/rolldown.d.ts",
      "import": "./dist/runtypes/rolldown.js"
    },
    "./runtypes/webpack": {
      "types": "./dist/runtypes/webpack.d.ts",
      "import": "./dist/runtypes/webpack.js"
    },
    "./runtypes/rspack": {
      "types": "./dist/runtypes/rspack.d.ts",
      "import": "./dist/runtypes/rspack.js"
    },
    "./runtypes/esbuild": {
      "types": "./dist/runtypes/esbuild.d.ts",
      "import": "./dist/runtypes/esbuild.js"
    },
    "./runtypes/bun": {
      "types": "./dist/runtypes/bun.d.ts",
      "import": "./dist/runtypes/bun.js"
    },
    "./runtypes/next": {
      "types": "./dist/runtypes/next/index.d.ts",
      "import": "./dist/runtypes/next/index.js"
    },
    "./runtypes/next/loader": {
      "types": "./dist/runtypes/next/loader.d.ts",
      "default": "./dist/runtypes/next/loader.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts",
    "oxlint-recommended.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://mion.pages.dev",
  "bugs": {
    "url": "https://github.com/MionKit/mion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/mion.git",
    "directory": "packages/devtools"
  },
  "scripts": {
    "build": "tsc --build tsconfig.dist.json",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "dev:test": "vitest watch",
    "clean": "node ../../scripts/lib/rmrf.mjs dist .dist .coverage .mion tsconfig.dist.tsbuildinfo tsconfig.tsbuildinfo",
    "fresh-start": "pnpm run clean && node ../../scripts/lib/rmrf.mjs node_modules"
  },
  "dependencies": {
    "unplugin": "3.3.0",
    "vite-node": "5.3.0",
    "@typescript-eslint/utils": "8.58.1"
  },
  "peerDependencies": {
    "@mionjs/bin-compiler": "workspace:*",
    "typescript": ">=6.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "workspace:*",
    "@mionjs/run-types": "workspace:*",
    "vite": "8.0.16"
  }
}
