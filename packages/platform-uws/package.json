{
  "name": "@mionjs/platform-uws",
  "version": "0.12.2",
  "type": "module",
  "description": "mion HTTP Server on uWebSockets.js for maximum performance.",
  "keywords": [
    "typescript",
    "API",
    "RPC",
    "json",
    "schema",
    "generate",
    "server",
    "serverless",
    "framework",
    "uWebSockets",
    "uws"
  ],
  "author": "ma jerez",
  "homepage": "https://mion.io/",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./.dist/esm/index.d.ts",
      "require": "./.dist/cjs/index.cjs",
      "default": "./.dist/esm/index.js"
    }
  },
  "directories": {
    "lib": ".dist"
  },
  "files": [
    ".dist",
    "index.ts",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/mion.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite build --watch",
    "dev:test": "vitest watch",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "build": "vite build",
    "clean": "rimraf .dist .coverage __runtypes",
    "fresh-start": "pnpm run clean && rimraf node_modules"
  },
  "bugs": {
    "url": "https://github.com/MionKit/mion/issues"
  },
  "comment:engines": "Inherited constraint from @mionjs/uws: uWebSockets.js ships prebuilt binaries only for these Node majors.",
  "engines": {
    "node": ">=22 <23 || >=24 <25 || >=26 <27"
  },
  "dependencies": {
    "@mionjs/core": "workspace:*",
    "@mionjs/router": "workspace:*",
    "@mionjs/uws": "workspace:*"
  }
}
