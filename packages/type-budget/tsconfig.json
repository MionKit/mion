{
  // noEmit-only: this package ships nothing, it just measures. `rootDir` is the
  // repo root because the harness imports the shared measurer from
  // packages/run-types/test/, which sits outside this directory.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": "../..",
    "sourceMap": false
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
