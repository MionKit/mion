{
  // `rootDir` is the repo root: the cost test imports other packages' test harnesses.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": "../..",
    "sourceMap": false,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
