{
    "name": "@mionjs/client",
    "version": "0.12.2",
    "type": "module",
    "sideEffects": false,
    "description": "Browser client for mion Apps.",
    "keywords": [
        "typescript",
        "API",
        "RPC",
        "json",
        "schema",
        "generate",
        "server",
        "serverless",
        "framework",
        "node"
    ],
    "author": "ma jerez",
    "homepage": "https://mion.io/",
    "license": "MIT",
    "exports": {
        ".": {
            "source": "./index.ts",
            "types": "./.dist/esm/index.d.ts",
            "require": "./.dist/cjs/index.cjs",
            "default": "./.dist/esm/index.js"
        }
    },
    "imports": {
        "#fetched-lane": {
            "source": "./src/lib/fetchedLane.ts",
            "require": "./.dist/cjs/src/lib/fetchedLane.cjs",
            "default": "./.dist/esm/src/lib/fetchedLane.js"
        }
    },
    "directories": {
        "lib": ".dist"
    },
    "files": [
        ".dist",
        "!.dist/**/*.tsbuildinfo",
        "!.dist/**/*.d.ts.map"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MionKit/mion.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "vitest run",
        "dev": "vite build --watch",
        "dev:test": "vitest watch",
        "lint": "eslint src",
        "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
        "format": "prettier --write src/**/*.ts",
        "build": "vite build",
        "clean": "rimraf .dist .coverage .mion .mion",
        "fresh-start": "pnpm run clean && rimraf node_modules"
    },
    "bugs": {
        "url": "https://github.com/MionKit/mion/issues"
    },
    "gitHead": "afd6e1d61525b4bf11bb84b3f85089038d70062d",
    "devDependencies": {
        "@mionjs/devtools": "workspace:*",
        "@mionjs/platform-node": "workspace:*",
        "@mionjs/router": "workspace:*",
        "@mionjs/test-server": "workspace:*"
    },
    "dependencies": {
        "@mionjs/core": "workspace:*",
        "@mionjs/run-types": "workspace:*"
    }
}
