{
  // Check-only config, shared with the editor: non-composite, no emit and no `references`, so a
  // cross-package import resolves through the `source` export condition instead of a sibling's
  // built declarations, which a fresh checkout has not got. tsconfig.build.json carries the emit.
  // `paths` is cleared because bundler resolution would otherwise take the root `paths` entry to each
  // sibling's built dist and hold two copies of every run-types type.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "incremental": false,
    "rootDir": "../..",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "paths": {}
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    ".dist",
    "vite.config.ts"
  ]
}
