{
  // Minimal program for the isolated mock-format-registry project: just this
  // directory's test file as root (its imports pull in the reachable src).
  // Extends the package check config so customConditions / rootDir / incremental all match; the
  // narrow include keeps this extra resolver instance's boot cheap.
  "extends": "../../tsconfig.json",
  "include": ["./*.test.ts"]
}
