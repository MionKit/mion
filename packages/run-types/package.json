{
    "name": "@mionjs/run-types",
    "version": "0.14.0",
    "description": "Sentinel marker + canonical reflection helper for mion RunTypes. The vite plugin rewrites every call of a function whose trailing parameter type is InjectRunTypeId<T> exported from this package.",
    "type": "module",
    "sideEffects": [
        "./src/formats/**",
        "./dist/formats/**",
        "./src/runtypes/**",
        "./dist/runtypes/**",
        "./src/builders/**",
        "./dist/builders/**",
        "./src/createRTFunctions.ts",
        "./dist/createRTFunctions.js"
    ],
    "license": "MIT",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./formats": {
            "source": "./src/formats/index.ts",
            "types": "./dist/formats/index.d.ts",
            "default": "./dist/formats/index.js"
        },
        "./formats/temporal": {
            "source": "./src/formats/datetime/temporalFormats.ts",
            "types": "./dist/formats/datetime/temporalFormats.d.ts",
            "default": "./dist/formats/datetime/temporalFormats.js"
        },
        "./mocking": {
            "source": "./src/mocking/index.ts",
            "types": "./dist/mocking/index.d.ts",
            "default": "./dist/mocking/index.js"
        },
        "./runtime": {
            "source": "./src/runtime/index.ts",
            "types": "./dist/runtime/index.d.ts",
            "default": "./dist/runtime/index.js"
        },
        "./builders": {
            "source": "./src/builders/index.ts",
            "types": "./dist/builders/index.d.ts",
            "default": "./dist/builders/index.js"
        }
    },
    "bin": {
        "mion-skills": "./bin/skills.mjs"
    },
    "files": [
        "dist",
        "!dist/**/*.tsbuildinfo",
        "!dist/**/*.d.ts.map",
        "bin",
        "skills",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://mion.io/runtypes",
    "bugs": {
        "url": "https://github.com/MionKit/mion/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MionKit/mion.git",
        "directory": "packages/run-types"
    },
    "scripts": {
        "build": "mion compile --tsconfig tsconfig.build.json --gen-dir .mion-build && node ../../scripts/core/hollow-builtin-purefns.mjs",
        "typecheck:test": "tsc -p tsconfig.json --noEmit",
        "pretest": "node ../../scripts/miondevx.mjs core build --trust-stamp",
        "test": "vitest run",
        "dev:test": "vitest watch",
        "clean": "node ../../scripts/lib/rmrf.mjs dist .mion .mion-build .coverage tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
        "fresh-start": "pnpm run clean && node ../../scripts/lib/rmrf.mjs node_modules"
    },
    "devDependencies": {
        "@mionjs/bin-compiler": "workspace:*",
        "@mionjs/devtools": "workspace:*"
    },
    "engines": {
        "node": ">=24"
    }
}
