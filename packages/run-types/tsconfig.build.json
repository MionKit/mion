{
  // Read by `mion compile`: re-enables the emit tsconfig.json turns off and narrows the program to src.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    // The maps carry the source text: src/ is not published, so a map pointing at it warns in every consumer.
    "inlineSources": true,
    "incremental": true,
    "outDir": "dist",
    "rootDir": "src",
    // No ambient @types in the published declarations: a consumer supplies its own.
    "types": []
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test", "vitest.config.ts"]
}
