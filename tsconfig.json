{
  // Shared base for every workspace package. The runtypes packages re-enable
  // noImplicitAny:true locally, so their strictness is unchanged by the
  // noImplicitAny:false the mion packages rely on.
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "esModuleInterop": true,
    "noImplicitAny": false,
    "removeComments": true,
    "noLib": false,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": ".dist/cjs",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@mionjs/*": ["./packages/*"]
    }
  },
  "references": [
    {"path": "./packages/core/tsconfig.build.json"},
    {"path": "./packages/router/tsconfig.build.json"},
    {"path": "./packages/client/tsconfig.build.json"},
    {"path": "./packages/platform-node/tsconfig.build.json"},
    {"path": "./packages/platform-aws/tsconfig.build.json"},
    {"path": "./packages/platform-gcloud/tsconfig.build.json"},
    {"path": "./packages/platform-bun/tsconfig.build.json"},
    {"path": "./packages/devtools/tsconfig.build.json"},
    {"path": "./packages/platform-cloudflare/tsconfig.build.json"},
    {"path": "./packages/platform-vercel/tsconfig.build.json"},
    {"path": "./packages/platform-uws/tsconfig.build.json"},
    {"path": "./packages/drizzle-orm-mysql-core/tsconfig.build.json"},
    {"path": "./packages/drizzle-orm/tsconfig.build.json"},
    {"path": "./packages/drizzle-orm-pg-core/tsconfig.build.json"},
    {"path": "./packages/drizzle-orm-sqlite-core/tsconfig.build.json"},
    {"path": "./packages/test-server/tsconfig.build.json"},
    {"path": "./packages/run-types/tsconfig.build.json"}
  ],
  "files": [],
  "exclude": ["node_modules", "dist", ".dist", "ts-go-runtypes", "mion-bin"]
}
