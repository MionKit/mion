{
  // Shared base for every workspace package. The runtypes packages re-enable
  // noImplicitAny:true locally, so their strictness is unchanged by the
  // noImplicitAny:false the mion packages rely on.
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "esModuleInterop": true,
    "noImplicitAny": false,
    "removeComments": true,
    "noLib": false,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": ".dist/cjs",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@mionjs/*": ["./packages/*"]
    }
  },
  "references": [
    {"path": "./packages/core"},
    {"path": "./packages/router"},
    {"path": "./packages/client"},
    {"path": "./packages/platform-node"},
    {"path": "./packages/platform-aws"},
    {"path": "./packages/platform-gcloud"},
    {"path": "./packages/platform-bun"},
    {"path": "./packages/devtools"},
    {"path": "./packages/platform-cloudflare"},
    {"path": "./packages/platform-vercel"},
    {"path": "./packages/platform-uws"},
    {"path": "./packages/drizzle-orm-mysql-core"},
    {"path": "./packages/drizzle-orm"},
    {"path": "./packages/drizzle-orm-pg-core/tsconfig.build.json"},
    {"path": "./packages/drizzle-orm-sqlite-core"},
    {"path": "./packages/test-server"},
    {"path": "./packages/type-budget"},
    {"path": "./packages/examples"},
    {"path": "./packages/run-types"}
  ],
  "files": [],
  "exclude": ["node_modules", "dist", ".dist", "ts-go-runtypes", "bin"]
}
