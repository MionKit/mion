{
  // History-join union (merge plan step 2): mion's compilerOptions are kept
  // because every @mionjs package extends this file and needs them
  // (customConditions, noImplicitAny:false, paths). The runtypes packages also
  // extend this file; each re-enables noImplicitAny:true locally so their
  // strictness is unchanged. TODO(step 3): unify for real.
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["source"],
    "esModuleInterop": true,
    "noImplicitAny": false,
    "removeComments": true,
    "noLib": false,
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": ".dist/cjs",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "sourceMap": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@mionjs/*": ["./packages/*"]
    }
  },
  "references": [
    {"path": "./packages/core"},
    {"path": "./packages/router"},
    {"path": "./packages/client"},
    {"path": "./packages/platform-node"},
    {"path": "./packages/platform-aws"},
    {"path": "./packages/platform-gcloud"},
    {"path": "./packages/platform-bun"},
    {"path": "./packages/devtools"},
    {"path": "./packages/test-server"},
    {"path": "./packages/ts-runtypes"},
    {"path": "./packages/ts-runtypes-devtools"}
  ],
  "files": [],
  "exclude": ["node_modules", "dist", ".dist", "ts-go-runtypes", "bin"]
}
