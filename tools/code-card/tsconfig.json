{
  // noEmit-only: this package ships nothing, Node runs its .ts sources directly.
  // cards/ holds snippets of APIs that may not exist yet, so it is never type checked.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": ".",
    "sourceMap": false,
    "erasableSyntaxOnly": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["."],
  "exclude": ["node_modules", "tmp", "cards"]
}
