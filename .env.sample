# RunTypes local environment. Copy this file to `.env` and fill in what you need:
#     cp .env.sample .env        (or: pnpm run check:env --create-env)
#
# `.env` (git-ignored) is auto-loaded from the repo root by loadEnv() in
# scripts/lib/env.mjs, which every `pnpm miondevx` command runs first. CI has no `.env`,
# so it never affects GitHub Actions. Inspect it with `pnpm run check:env`.
#
# This file lists the USER-SETTABLE vars only: the secrets you need for a given task
# plus the overridable knobs (all have defaults, so they stay commented out). The
# complete registry, including the internal/protocol vars the scripts set themselves,
# lives in scripts/lib/env.mjs (REGISTRY) and is printed by `pnpm run check:env`.
# Never add an internal var here - setting it breaks the run. Every NEW env var must
# be registered in scripts/lib/env.mjs first (MION_ prefix for project-owned vars).
# `pnpm run check:env` ENFORCES that mirror: it exits 1 when a secret/dev row is
# missing here, when an internal var is listed, or when a key here is unregistered.

# === Secrets (only needed to run that task from your machine; GitHub secrets in CI) ===
# GHCR push/pull: a GitHub PAT (write:packages to push, read:packages for a private pull).
GHCR_PAT=
# npm publish: the local publish (scripts/release/publish.mjs) reads it from here,
# and CI stage-publishes with the same token supplied as a GitHub secret:
# NPM_TOKEN=
# Cloudflare Pages deploy (a token with "Cloudflare Pages: Edit"):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Pages project names, one per site (not secrets; CI sets them in website-deploy.yml).
# CLOUDFLARE_PAGES_PROJECT=runtypes
# CLOUDFLARE_PAGES_PROJECT_MION=mion

# === GHCR coordinates (defaults already target this repo) ===
# GHCR_OWNER=mionkit
# GHCR_USER=
# GHCR_REGISTRY=ghcr.io

# === Image source (uncomment to BUILD/USE a local image instead of pulling from GHCR) ===
# MION_WEBSITE_USE_LOCAL=1
# MION_VALIDATION_BENCH_USE_LOCAL=1

# === Docs website knobs (pnpm miondevx website ...) ===
# Which of the two sites to serve/build (one Nuxt install, two content trees).
# MION_SITE=runtypes
# MION_WEBSITE_ENGINE=podman
# MION_WEBSITE_IMAGE=tsrt-website:dev
# MION_WEBSITE_CONTAINER=tsrt-website
# MION_WEBSITE_PORT=3000
# MION_WEBSITE_AGENT_PORT=3100
# MION_WEBSITE_AGENT_IDLE_SECONDS=300
# MION_WEBSITE_POLL=1                # fs polling for watchers (default 1 on macOS, 0 on Linux)
# MION_WEBSITE_REPO_CONTEXT=         # host checkout with packages/ (default this repo)
# MION_WEBSITE_DOCDATA=.docdata
# MION_WEBSITE_SKIP_PLAYGROUND=1
# MION_WEBSITE_PARALLEL=1            # build both sites at once (two containers, ~6 GB heap each)
# MION_WEBSITE_MOUNT_OPTS=           # e.g. :z on SELinux
# MION_WEBSITE_RUN_NETWORK=          # e.g. host behind a proxy
# MION_WEBSITE_BUILD_NETWORK=
# MION_WEBSITE_BASE_IMAGE=node:26-bookworm
# MION_WEBSITE_PNPM_VERSION=
# MION_WEBSITE_CA_CERT=              # extra CA certs (corporate/MITM proxy): baked at build
#                                  # time AND mounted at run time (e2e verdaccio uplink)
# MION_WEBSITE_REMOTE_IMAGE=
# MION_WEBSITE_SMOKE_TIMEOUT=90

# === Benchmark knobs (pnpm miondevx bench ...) ===
# MION_VALIDATION_BENCH_NO_TYPIA=1             # skip the typia competitor
# MION_VALIDATION_BENCH_QUICK=1                # fast/preview numbers (noisy)
# MION_VALIDATION_BENCH_ENGINE=podman
# MION_VALIDATION_BENCH_IMAGE=tsrt-website:dev
# MION_VALIDATION_BENCH_CONTAINER=tsrt-bench
# MION_VALIDATION_BENCH_NO_TIMING=1            # correctness-only
# MION_VALIDATION_BENCH_TIME_MS=100            # per-cell timing window (ms)
# MION_VALIDATION_BENCH_BUN=0                  # skip the bun runtime lane (default: on)
# MION_VALIDATION_BENCH_CASE=                  # restrict to matching case names
# MION_VALIDATION_BENCH_DUMP=                  # print typecost probe sources
# MION_VALIDATION_BENCH_SERIALIZATION_OUT=
# MION_COMPILETIME_N=5
# MION_COMPILETIME_COMPETITORS=mion typia
# MION_TRANSFORM_WIRE_N=5
# MION_VALIDATION_BENCH_DOCDATA=.docdata
# MION_VALIDATION_BENCH_REMOTE_IMAGE=
# MION_VALIDATION_BENCH_MOUNT_OPTS=
# MION_VALIDATION_BENCH_RUN_NETWORK=
# MION_VALIDATION_BENCH_BUILD_NETWORK=
# MION_VALIDATION_BENCH_BASE_IMAGE=
# MION_VALIDATION_BENCH_PNPM_VERSION=
# MION_VALIDATION_BENCH_CA_CERT=

# === Fuzz test knobs (pnpm miondevx core fuzz <suite>) ===
# MION_FUZZ_SEED=
# MION_FUZZ_ITER=
# MION_FUZZ_SOAK_MS=60000
# MION_FUZZ_TYPES_SOAK_MS=60000
# MION_FUZZ_SIZE_SOAK_MS=
# MION_FUZZ_ROUNDTRIP_SOAK_MS=
# MION_FUZZ_ELISION_SOAK_MS=
# MION_FUZZ_NONDATA_SOAK_MS=
# MION_FUZZ_CLONE_SOAK_MS=
# MION_FUZZ_ENRICH_SEQUENCES=6
# MION_FUZZ_ENRICH_MAXCMDS=8
# MION_FUZZ_ENRICH_REPLAY=
# MION_FUZZ_I18N_SEQUENCES=6
# MION_FUZZ_I18N_MAXCMDS=10
# MION_FUZZ_I18N_REPLAY=
# MION_FUZZ_TYPEMOD_SEQUENCES=6
# MION_FUZZ_TYPEMOD_MAXSTEPS=8
# MION_FUZZ_TYPEMOD_REPLAY=
# MION_FUZZ_TYPEMOD_REPORT=1
# MION_FUZZ_TYPEMOD_DEBUG=1
# MION_FUZZ_RACE=1
# MION_FUZZ_RACE_ITERATIONS=2
# MION_FUZZ_RACE_FANOUT=6

# === Resolver knobs (the mion Go binary) ===
# Point @mionjs/bin at a specific resolver binary, overriding the installed
# platform package (and this repo's bin/mion) for BOTH the bundler plugins
# and the lint plugin. Must be an executable file; a bad path fails loudly.
# WARNING: the binary version folds into every typeId, so a different-version
# override produces caches that diverge from a normal install.
# MION_BIN=/abs/path/to/ts-runtypes

# Internal disk-cache override. Unset = the cache follows the tsconfig
# incremental/composite setting (on when incremental, off otherwise). Set a path
# to force it on there, or "" to force it off. For tests/benches/power users.
# MION_CACHE_DIR=

# Path to the node/bun the resolver runs format-pattern checks on, consulted when
# no --js-runtime flag is passed. The bundler/lint plugins always pass their own
# process.execPath, so this matters for direct binary use (serve/compile by hand).
# Unset: the binary probes PATH for node, then bun.
# MION_JS_RUNTIME=/abs/path/to/node

# === Build/release knobs ===
# Attach npm provenance on the CI stage-publish. Off by default: npm refuses
# provenance from a PRIVATE source repo. When this repo is public, set the GitHub
# repo variable MION_NPM_PROVENANCE=1 (this .env line only affects a local publish).
# MION_NPM_PROVENANCE=1
# Publish tarballs with no e2e receipt (the env twin of --no-receipt). An escape
# hatch for a broken gate, never a normal step: the receipt is what makes
# "e2e passed" checkable rather than a convention.
# MION_ALLOW_UNVERIFIED_PUBLISH=1
# REWRITE the schema-document golden corpus instead of failing on drift. Only
# after an INTENTIONAL spelling change; the corpus exists to catch accidental ones.
# MION_UPDATE_GOLDEN=1

# === Lint knobs (@mionjs/devtools OXlint/ESLint plugin) ===
# MION_LINT_PRESPAWN=0

# === Next.js / Turbopack adapter knobs (RunTypes/devtools/next) ===
# Trace the Next broker: owner election, buildStart, absorbed edit batches, stamp changes.
# MION_NEXT_DEBUG=1

# === Pre-publish e2e knobs (pnpm miondevx release e2e) ===
# Point the e2e apps' RunTypes plugin at an in-repo binary for host iteration.
# The lint lanes take no binary option, so their spawners forward this value to
# the launcher as MION_BIN. Leave unset in-container / in CI so the PUBLISHED
# @mionjs/bin launcher resolves the platform binary — exactly what the e2e
# exists to prove.
# MION_E2E_BINARY=./bin/mion

# === Engine-branch tripwire (pnpm miondevx bench engine-check) ===
# Fail instead of only reporting when the rt::countEnumKeys counter pick looks
# inverted. NOT the same knob as MION_VALIDATION_BENCH_ENGINE, which picks the container engine.
# MION_VALIDATION_BENCH_ENGINE_ASSERT=1
# How much faster the selected counter must be before the pick is called wrong.
# MION_VALIDATION_BENCH_ENGINE_MARGIN=1.15
# Iterations per measurement.
# MION_VALIDATION_BENCH_ENGINE_ITERS=2000000

# === mion HTTP server benchmarks (pnpm miondevx bench servers) ===
# These run in their OWN image (mion-bench), so they have their own knobs; the
# MION_VALIDATION_BENCH_* set above drives the validation benchmarks in tsrt-website.
# MION_BENCH_ENGINE=podman
# MION_BENCH_IMAGE=mion-bench:dev
# MION_BENCH_REMOTE_IMAGE=ghcr.io/mionkit/mion-bench:latest
# Build the image locally instead of pulling it (offline, or testing a dep bump).
# MION_BENCH_USE_LOCAL=1
# Short load windows for a dev loop. The numbers are noisy and must NOT be published.
# MION_BENCH_QUICK=1
# Seconds of measured load per lane, and of warm-up before it.
# MION_BENCH_DURATION=20
# MION_BENCH_WARMUP=5
# Load shape.
# MION_BENCH_CONNECTIONS=100
# MION_BENCH_PIPELINING=1
# Seconds to wait for a response before the request counts as an error.
# MION_BENCH_TIMEOUT=60
# Ceiling on request-body bytes in flight (caps connections on the big sweep sizes).
# MION_BENCH_INFLIGHT_BUDGET=104857600
# Port the benchmarked server listens on inside the container.
# MION_BENCH_PORT=3000
# Host dir to publish the result JSON into.
# MION_BENCH_DOCDATA=.docdata
# Extra bind-mount opts (":z" on SELinux) and podman run network.
# MION_BENCH_MOUNT_OPTS=
# MION_BENCH_RUN_NETWORK=

# === Alignment-audit knobs (pnpm run audit:alignment) ===
# MION_AUDIT_OUT_DIR=
# MION_AUDIT_TSX=

# === mion framework knobs ===
# Expose @mionjs/router's public routes data (the router spec).
# GENERATE_ROUTER_SPEC=true
# Silence @mionjs/core's warning when it is loaded twice in one process.
# MION_SUPPRESS_DUAL_LOAD_WARN=1
# Directory with a uWebSockets.js binary (uws_<platform>_<arch>_<abi>.node) that
# @mionjs/uws loads instead of the fetched cache / optional dependency.
# MION_UWS_BINARY_DIR=
