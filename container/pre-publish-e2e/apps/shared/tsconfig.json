{
  // The shared library's tsconfig. @mionjs/* resolves from node_modules
  // (verdaccio-installed in-container; a workspace symlink for host iteration) —
  // no workspace `paths`, so every bundler resolves it identically to a real consumer.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "src",
    "types": []
  },
  "include": ["src"]
}
