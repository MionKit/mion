{
  "extends": "../../tsconfig.base.json",
  // The point of this app: a source-first consumer. `customConditions: ["source"]` makes
  // @acme/src-types resolve to its `src/index.ts`, so the RT plugin's whole-program scan walks
  // the LIBRARY's own source, including a non-literal CompTimeArgs call. Those are not consumer
  // call sites — the resolver's first-party diagnostic scoping must drop them, else the build
  // halts on CTA001/CTA003. The @mionjs/* packages ship no sources, so the fixture is what
  // supplies this shape now.
  "compilerOptions": {
    "customConditions": ["source"]
  },
  "include": ["src", "../shared/src"]
}
