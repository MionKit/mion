# syntax=podman
# -----------------------------------------------------------------------------
# drizzle-e2e, postgres lane: a real postgres server plus everything needed to
# translate drizzle's own integration suites onto the slim
# @mionjs/drizzle-orm-pg-core and run them against it.
#
# WHY THE DATABASE IMAGE IS THE BASE, not node: drizzle's suites are written
# against real postgres, and the official image is the one thing that reliably
# IS real postgres — its entrypoint initialises the cluster, sets the superuser
# and applies the tuning the suites assume. Node arrives from the official
# tarball on top, which is three deterministic lines. The other way round
# (node base + apt) means picking a distro's postgres build and reproducing that
# entrypoint by hand.
#
# NO DOCKER-IN-DOCKER. pg-common.ts ships a createDockerDB() helper, but every
# runner prefers PG_CONNECTION_STRING when it is set, so pointing at this
# container's own server bypasses it. dockerode is still installed: the suite
# imports it at the top level whether or not it reaches the helper.
#
# DEPS-ONLY IMAGE: only _deps/package.json, the shared workspace policy and the
# verdaccio assets are baked. The runners, the skip list and the run script are
# bind-mounted at run time (scripts/release/drizzle-e2e.mjs mounts
# container/drizzle-e2e/shared as /drizzle-src), so editing them never
# invalidates the install layer.
# -----------------------------------------------------------------------------
ARG BASE_IMAGE=postgres:17-trixie
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/MionKit/mion
LABEL org.opencontainers.image.description="mion drizzle-e2e, postgres lane - real postgres + the toolchain that translates drizzle's own suites onto @mionjs/drizzle-orm-pg-core and runs them"

ENV DO_NOT_TRACK=1

# -- Optional: trust extra CA certs (corporate / MITM egress proxy) -----------
# MUST come before any network step. The .cacerts/ dir is ALWAYS present in the
# build context (scripts/container/image.mjs creates it) but is empty unless a
# proxy CA was supplied, so this layer costs nothing on a normal build.
COPY .cacerts/ /usr/local/share/ca-certificates/
RUN update-ca-certificates >/dev/null 2>&1 || true
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# The postgres image ships an http:// pgdg source list. This build never needs a
# pgdg package (curl and friends come from Debian's own repos), but apt-get update
# fails the whole `&&` chain when it cannot reach one source, and an unencrypted
# apt source is worth moving to https regardless.
RUN sed -i 's|http://apt\.postgresql\.org|https://apt.postgresql.org|g' \
      /etc/apt/sources.list.d/pgdg.list 2>/dev/null || true

# Node, from the official tarball. Pinned: an unpinned runtime could move the
# result with no code change. libatomic1 is not optional — node's linux-arm64
# build links against it, and the postgres image does not ship it.
ARG NODE_VERSION=26.7.0
RUN set -eux; \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates xz-utils libatomic1 \
      && rm -rf /var/lib/apt/lists/*; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) nodeTarget='linux-x64' ;; \
      arm64) nodeTarget='linux-arm64' ;; \
      *) echo "unsupported arch for node: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-${nodeTarget}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --exclude=CHANGELOG.md --exclude=LICENSE --exclude=README.md; \
    rm /tmp/node.tar.xz; \
    node --version

# The extension types the addendum exercises. vector/halfvec/sparsevec and
# geometry are real column types in the manifests, so the coverage gate demands
# they hit a real database — which means the server needs the extensions.
RUN set -eux; \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      postgresql-17-pgvector postgresql-17-postgis-3 \
      && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=11.1.1
RUN npm install -g pnpm@${PNPM_VERSION}

# verdaccio: the in-container registry the packed tarballs are published to, so
# the lane installs the packages as a consumer would.
RUN npm install -g verdaccio@6.7.2

WORKDIR /drizzle-e2e
COPY _deps/package.json ./package.json
COPY .shared/_deps-common/pnpm-workspace.yaml .shared/_deps-common/.npmrc ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile

# The registry config + serve script, LAST so a tweak never invalidates the
# heavier install layer above.
COPY .shared/registry/verdaccio.yaml /etc/verdaccio/config.yaml
COPY .shared/registry/drizzle-serve.sh /usr/local/bin/drizzle-serve.sh
RUN chmod +x /usr/local/bin/drizzle-serve.sh

# The official entrypoint reads these on first boot to initialise the cluster.
# Loopback only, inside a throwaway container.
ENV POSTGRES_PASSWORD=postgres
ENV POSTGRES_USER=postgres
ENV POSTGRES_DB=postgres
ENV PGDATA=/var/lib/postgresql/data

EXPOSE 4873

# Stamp the manifests this image was baked from; scripts/container/image.mjs
# compares it against the tree before a run, so a `_deps` bump that was never
# republished is caught here. LAST so it only invalidates this one-line layer.
ARG DEPS_HASH=unknown
LABEL org.mionkit.deps-hash="${DEPS_HASH}"

# No CMD: scripts/release/drizzle-e2e.mjs starts the registry, then execs the run
# script against the bind-mounted /drizzle-src.
