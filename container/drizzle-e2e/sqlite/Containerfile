# syntax=podman
# -----------------------------------------------------------------------------
# drizzle-e2e, sqlite lane: everything needed to translate drizzle's own
# integration suites onto the slim @mionjs/drizzle-orm-sqlite-core and run them.
#
# The lightest of the three by far, which is the payoff for three images rather
# than one shared one: sqlite has no server, so this is a plain node base and a
# database file. sqlite-common.ts imports nothing but drizzle and vitest.
#
# SQLITE_DB_PATH points the suite at a file under /tmp; drizzle's runners default
# to :memory:, and a file is closer to what a consumer runs.
#
# DEPS-ONLY IMAGE: only _deps/package.json, the shared workspace policy and the
# verdaccio assets are baked. The runners, the skip list and the run script are
# bind-mounted at run time (scripts/release/drizzle-e2e.mjs mounts
# container/drizzle-e2e/shared as /drizzle-src), so editing them never
# invalidates the install layer.
# -----------------------------------------------------------------------------
ARG BASE_IMAGE=node:26-trixie
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source=https://github.com/MionKit/mion
LABEL org.opencontainers.image.description="mion drizzle-e2e, sqlite lane - the toolchain that translates drizzle's own suites onto @mionjs/drizzle-orm-sqlite-core and runs them against a database file"

ENV DO_NOT_TRACK=1

# -- Optional: trust extra CA certs (corporate / MITM egress proxy) -----------
# MUST come before any network step. The .cacerts/ dir is ALWAYS present in the
# build context (scripts/container/image.mjs creates it) but is empty unless a
# proxy CA was supplied, so this layer costs nothing on a normal build.
COPY .cacerts/ /usr/local/share/ca-certificates/
RUN update-ca-certificates >/dev/null 2>&1 || true
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Node 26 dropped the bundled corepack shim (it ships only npm), so install the
# repo-pinned pnpm globally.
ARG PNPM_VERSION=11.1.1
RUN npm install -g pnpm@${PNPM_VERSION}

# verdaccio: the in-container registry the packed tarballs are published to, so
# the lane installs the packages as a consumer would.
RUN npm install -g verdaccio@6.7.2

WORKDIR /drizzle-e2e
COPY _deps/package.json ./package.json
COPY .shared/_deps-common/pnpm-workspace.yaml .shared/_deps-common/.npmrc ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile

# The registry config + serve script, LAST so a tweak never invalidates the
# heavier install layer above.
COPY .shared/registry/verdaccio.yaml /etc/verdaccio/config.yaml
COPY .shared/registry/drizzle-serve.sh /usr/local/bin/drizzle-serve.sh
RUN chmod +x /usr/local/bin/drizzle-serve.sh

EXPOSE 4873

# Stamp the manifests this image was baked from; scripts/container/image.mjs
# compares it against the tree before a run, so a `_deps` bump that was never
# republished is caught here. LAST so it only invalidates this one-line layer.
ARG DEPS_HASH=unknown
LABEL org.mionkit.deps-hash="${DEPS_HASH}"

# No CMD: scripts/release/drizzle-e2e.mjs starts the registry, then execs the run
# script against the bind-mounted /drizzle-src.
