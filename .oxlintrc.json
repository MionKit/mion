{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "plugins": [
    "typescript",
    "oxc",
    "unicorn"
  ],
  "jsPlugins": [
    "./packages/ts-runtypes-devtools/dist/eslint/index.js"
  ],
  "rules": {
    "runtypes/no-enrichment-todo": "error",
    "runtypes/no-orphan-carcass": "error",
    "runtypes/enrichment-field": "error",
    "runtypes/enrichment-broken-source": "error",
    "no-empty-function": "off",
    "typescript/no-empty-function": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-empty-object-type": "error",
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [
          "string"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    "ts-go-runtypes/**",
    "**/dist/**",
    "**/.dist/**",
    "**/coverage/**",
    "**/.coverage/**",
    "**/test/**",
    "packages/examples/**",
    "packages/run-types/src/caches/**",
    "container/**",
    "docs/**",
    "bin/**",
    "scripts/**",
    "benchmarks/**",
    ".claude/**",
    "**/vite.config.ts",
    "**/vitest.config.ts",
    "**/vitest.workspace.ts",
    "eslint.config.js"
  ],
  "overrides": [
    {
      "files": [
        "**/*.routes.ts",
        "**/*.spec.ts",
        "**/*.test.ts"
      ],
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "args": "none"
          }
        ],
        "typescript/no-unused-vars": [
          "warn",
          {
            "args": "none"
          }
        ]
      }
    }
  ]
}
