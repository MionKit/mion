# ── Union of the framework and type-system ignore rules (history join) ──

# Go
/bin/
*.test
*.out
*.prof
coverage.txt

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
.coverage
.coverage/
packages/*/.coverage/

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
packages/*/node_modules/
jspm_packages/
.pnpm-store/

# TypeScript v1 declaration files
typings/

# TypeScript build info
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.local

# next.js build output
.next


########################
# misc / editors
########################
*~
*#
.DS_STORE
.DS_Store
.netbeans
nbproject
.kilocode
*.swp
*.swo
# Track shared workspace settings/extensions, ignore user-specific files.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea
.idea/

########################
# generated files
########################
.dist
.dist/
dist
dist/
packages/*/dist/
packages/*/.dist/
# test-server's edge/workers bundles ARE generated: the platform specs rebuild them in their
# vitest globalSetup, so a committed copy could only ever be a stale one.
packages/test-server/build/
.tmp
tmp
.nx

# The RunTypes output root (default `.mion/` next to each project's source):
# generated cache modules under `types/` and, in THIS repo only, throwaway
# enrichment scaffolds under `enriched/` (in a consumer project `enriched/` is
# committed; every in-repo tree is a test artifact). The project-root `.mion/`
# also holds the serverMapFrom mapper manifests (build artifact, regenerated
# every build). `.mion-<target>/` are the extra genDirs test-server's
# edge/cloudflare builds need, because those builds disagree with the node build
# on emitMode and must not share one dir.
.mion/
.mion-*/

########################
# type-system side
########################

# AI-enrichment generation suite — synthesized temp module files
# (recreated + cleaned per run by test/util/enrichGen.ts).
packages/run-types/test/suites/enrich/.tmp/

# Converted-suite trees: the whole suite tree rewritten into the value forms by
# `pnpm miondevx core converted-suites`, which generates, runs and removes them.
/packages/run-types/test/converted-builders/

# Build / pack artefacts
/runtypes-cache.json
/tarballs/
# Cross-compiled per-platform binary packages, staged for publish by
# scripts/release/build-binaries.mjs (assembled, never committed).
/dist-binaries/
# On-demand-fetched uWebSockets.js prebuilt binaries (sha256-verified against
# packages/uws/uws-checksums.json by scripts/lib/fetch-uws.mjs; never committed).
/packages/uws/.uws-cache/
# Host-built playground WASM cache: the raw .wasm (buildid oracle + Node test
# resolver) + the mion source overlay, produced by
# container/website/scripts/build-playground.sh. Large + reproducible; the browser
# copies are staged into container/website/public/playground-app/ (also ignored).
/.cache/rt-wasm/
# drizzle's own integration suites, fetched on demand and sha256-verified against
# drizzle-suites.pin.json by scripts/drizzle/fetch-suites.mjs. Upstream Apache-2.0
# source the drizzle-e2e lane translates and runs; never committed.
/.cache/drizzle-suites/

# Consumer e2e fixture install artifacts (the fixture source IS tracked).
/container/pre-publish-e2e/package-lock.json
/logs/

# Benchmark output (raw harness logs; aggregated summaries live in docs/)
/bench/results/
/container/benchmarks/results/

# Generated benchmark/test result JSON the docs website reads (read-only mount)
/.docdata/

# Stale leftovers from the container-website/ -> container/website/ rename:
# generated build output (.output) and bench artifacts. Nothing tracked or any
# current script writes here (the live paths live under container/), so these
# are disposable; ignore them rather than churn the working tree.
/container-website/
/container-benchmarks/

# Claude Code local (per-developer) settings
.claude/settings.local.json

# Claude Code agent worktrees (transient, auto-cleaned isolated checkouts)
.claude/worktrees/

# vite config timestamp artifacts
*.timestamp-*.mjs

# RunTypes files-mode output: every `.mion/` tree in this repo (the marker
# package's own test suite, the isolated mock-format-registry project, the enrich
# fuzz dir, the repo root when a solution-style tsconfig resolves there) is a
# build artifact, covered by the repo-wide `.mion/` rule above. A leaked scaffold
# under enriched/ once got swept into a commit, which `types/`'s own inner
# .gitignore cannot prevent for the enriched/ half — hence wholesale.
# Cross-bundler real-build test fixtures (created + cleaned per run).
/packages/run-types/test/tmp-build-*/

# playwright-cli session artifacts (snapshots, traces, screenshots)
.playwright-cli/
